{
  "manifest_version": 3,
  "name": "MVX Provisioning Dashboard",
  "version": "1.0.0",
  "description": "Cruza pendências do Superset com a atividade Configuração de Equipamento no ERP.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "https://dashboard.mundivox.com/*",
    "https://erp.mundivox.com/*",
    "https://carloshsgandra.github.io/DashboardMVX/*"
  ],
  "background": {"service_worker": "background.js"},
  "options_page": "options.html",
  "action": {"default_title": "MVX Provisioning"},
  "content_scripts": [{
    "matches": [
      "https://dashboard.mundivox.com/*",
      "https://erp.mundivox.com/*",
      "https://carloshsgandra.github.io/DashboardMVX/*"
    ],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }]
}
